# Copy to .env.local and fill in your Supabase project's values.

# Origin of the API (the deployed `api` edge function). The client appends /v1/...
NEXT_PUBLIC_API_BASE_URL=https://<project-ref>.supabase.co/functions/v1/api

# Used for metadataBase, canonical URLs, and OG images. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Auth (public keys — safe to expose in the client bundle)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
